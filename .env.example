# Application
PORT=3000
NODE_ENV=development
START_WORKERS=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=jungle
DB_PASSWORD=jungle_secret
DB_NAME=wagering_db

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ENDPOINT=http://localhost:4566

# SQS Queues
SQS_INCOMING_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_OUTBOX_QUEUE_URL=http://localhost:4566/000000000000/integration-events.fifo

