{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for Jungle Gaming Technical Challenge",
  "author": "Jungle Gaming Candidate",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:nest": "nest start --watch",
    "start:prod": "bun src/main.ts",
    "test": "bun test",
    "test:unit": "bun test src/**/*.spec.ts",
    "test:integration": "bun test test/integration/**/*.spec.ts",
    "test:concurrency": "bun test test/concurrency/**/*.spec.ts",
    "test:load": "bun run test/load/load-test.ts",
    "mikro-orm": "bun --bun ./node_modules/@mikro-orm/cli/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/cli": "^6.4.8",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
